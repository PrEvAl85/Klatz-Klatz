{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Klatz-Klatz",
  "version": "0.1.0",
  "identifier": "com.klatz.klatz",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Klatz-Klatz",
        "width": 460,
        "height": 640,
        "minWidth": 420,
        "minHeight": 560,
        "resizable": false,
        "center": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Keyboard layout switcher",
    "longDescription": "Klatz-Klatz switches the keyboard layout from the system tray or with a global hotkey.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libayatana-appindicator3-1"]
      }
    }
  }
}